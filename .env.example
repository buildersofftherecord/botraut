# AI Gateway — se provisiona con `vercel env pull`, no se pone a mano.
# VERCEL_OIDC_TOKEN=

# El slug del modelo. Se decide en el spike de la Task 14: los slugs del
# Gateway usan puntos, no guiones, y la lista cambia. Verificar con
# gateway.getAvailableModels() antes de fijar un valor.
MODELO_COPY=

# Modelo de visión que juzga la silueta recortada (Task 22b, lib/mirar.ts).
# Mismo criterio que MODELO_COPY: si no se define, usa el default del código.
MODELO_VISION=

# Slack — de api.slack.com/apps, después de instalar la app al workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Redis (Upstash, desde el marketplace de Vercel).
REDIS_URL=

# Blob.
BLOB_READ_WRITE_TOKEN=

# Búsqueda de imágenes. El proveedor se decide en el spike de la Task 12.
BUSQUEDA_IMAGENES_API_KEY=
BUSQUEDA_IMAGENES_CX=

# Recorte de fondo. Solo hace falta si la Task 13 elige un servicio pago
# en vez de la opción local.
RECORTE_API_KEY=
