# ── Modelos ────────────────────────────────────────────────────────────────
#
# Todas las resuelve `lib/modelos.ts`, que es el único archivo que importa un
# proveedor. Dejarlas vacías usa los defaults del código.
#
# La BARRA decide por dónde sale la llamada:
#
#   gemini-3.5-flash-lite          → Google directo (GOOGLE_GENERATIVE_AI_API_KEY)
#   google/gemini-3.5-flash-lite   → el mismo modelo vía AI Gateway
#   anthropic/claude-sonnet-5      → otro proveedor, vía AI Gateway
#
# Migrar a Gateway es agregarle el prefijo a estas variables. No se toca código.
# Hoy no se puede: el Gateway pide tarjeta (ver docs/decisiones/003).

# Google directo. Necesaria mientras los slugs no lleven prefijo de proveedor.
GOOGLE_GENERATIVE_AI_API_KEY=

# AI Gateway — se provisiona con `vercel env pull`, no se pone a mano.
# Solo hace falta si algún slug de abajo lleva barra.
# VERCEL_OIDC_TOKEN=

# El agente que conversa en Slack y llama a las herramientas (lib/agente.ts).
# Si está vacía cae en MODELO_COPY, que es lo que leía antes de tener la suya.
MODELO_AGENTE=

# El que redacta el rol del invitado (lib/buscar.ts).
MODELO_COPY=

# Visión: juzga la silueta recortada (lib/mirar.ts). NO hereda de MODELO_COPY
# a propósito — su default es `flash` y no `flash-lite` porque juzgar una imagen
# es más duro que redactar un rol.
MODELO_VISION=

# Visión: mide dónde está la cara para encuadrar (lib/encuadre.ts).
# Si está vacía cae en MODELO_COPY.
MODELO_ENCUADRE=

# Slack — de api.slack.com/apps, después de instalar la app al workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Redis (Upstash, desde el marketplace de Vercel).
REDIS_URL=

# Blob.
BLOB_READ_WRITE_TOKEN=

# Búsqueda de imágenes. El proveedor se decide en el spike de la Task 12.
BUSQUEDA_IMAGENES_API_KEY=
BUSQUEDA_IMAGENES_CX=

# Recorte de fondo. Solo hace falta si la Task 13 elige un servicio pago
# en vez de la opción local.
RECORTE_API_KEY=
